#!/usr/bin/env bash
set -euo pipefail

if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  echo "hd: needs bash 4.4+, found $BASH_VERSION (macOS: brew install bash)" >&2
  exit 1
fi

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-delegate"
PI_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
CODEX_SESSIONS="$HOME/.codex/sessions"
JOURNAL="$RUN_ROOT/journal.jsonl"
CHECK_TIMEOUT="$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)"
source "$SKILL_DIR/zcode.sh"

usage() {
  cat <<'EOF'
hd spawn <name> <slot> [--agent pi|codex|zcode] [--cwd DIR] [--model M] [--thinking T] [--session FILE]
hd ask <name> <brief | @file> [--timeout MS]
hd wait <name> [--timeout MS]
hd result <name>
hd diff <name> [git diff args]
hd peek <name> [lines]
hd ls
hd stop <name>
hd resume <name> [--cwd DIR] [--model M] [--thinking T]
hd note <name> <text>

slots: config $HD_CONFIG or ~/.config/hd/config.json; built in: sidekick worker scout reviewer researcher
EOF
  exit 2
}

die() { echo "hd: $*" >&2; exit 1; }

config_path() { printf '%s\n' "${HD_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/hd/config.json}"; }

config_json() {
  local path="$1" var body
  for var in HD_HARNESS HD_MODEL HD_THINKING HD_PI_EXTENSIONS; do
    [[ -z "${!var+x}" ]] || die "$var is set; hd reads $path now: move the value there and unset $var"
  done
  [[ -f "$path" ]] || die "no config file $path"
  body="$(jq -c -s 'if length == 1 and (.[0] | type) == "object" then .[0] else empty end' "$path" 2>/dev/null)" || die "$path is not valid JSON"
  [[ -n "$body" ]] || die "$path is not valid JSON"
  printf '%s\n' "$body"
}

slot_known() {
  jq -e --arg slot "$2" '(.slots // {} | if type == "object" then has($slot) else false end)
    or (["sidekick", "worker", "scout", "reviewer", "researcher"] | index($slot) != null)' <<<"$1" >/dev/null
}

resolve_slot() {
  jq -c --arg slot "$2" --arg home "$HOME" \
    --arg flag_agent "$3" --arg flag_model "$4" --arg flag_thinking "$5" \
    --argjson have_agent "$6" --argjson have_model "$7" --argjson have_thinking "$8" '
    def obj: if type == "object" then . else {} end;
    . as $cfg
    | ($cfg.slots // {} | obj) as $slots
    | ($cfg.default // {} | obj) as $def
    | ($slots[$slot] // {} | obj) as $s
    | ($s.role // (if (["sidekick", "worker", "scout", "reviewer", "researcher"] | index($slot)) != null then $slot else ($def.role // $slot) end)) as $role
    | ($s.harness // $def.harness) as $base_harness
    | ($s.model // $def.model) as $base_model
    | ($s.thinking // $def.thinking) as $base_thinking
    | ($s.pi_extensions // $def.pi_extensions // [] | if type == "array" then map(tostring) else [] end) as $exts
    | ($s.fallback // $def.fallback // [] | if type == "array" then . else [] end) as $raw
    | [$raw[] | obj | {harness: (.harness // $base_harness), model: (.model // $base_model), thinking: (.thinking // $base_thinking)}] as $fallback
    | (if $have_agent == 1 then $flag_agent else $base_harness end) as $harness
    | (if $have_model == 1 then $flag_model else $base_model end) as $model
    | (if $have_thinking == 1 then $flag_thinking else $base_thinking end) as $thinking
    | ($cfg.providers // {} | obj) as $providers
    | ([ (if $harness == "pi" then $model else empty end),
         ($fallback[] | select(.harness == "pi") | .model) ]
       | map(select(type == "string" and length > 0) | split("/")[0])
       | unique) as $pi_providers
    | [$pi_providers[] as $p | ($providers[$p] // {} | obj | .pi_extension) | select(type == "string" and length > 0)] as $provider_exts
    | {role: ($role | tostring),
       harness: ($harness // "" | tostring),
       model: ($model // "" | tostring),
       thinking: ($thinking // "" | tostring),
       pi_extensions: $exts,
       extensions: (($exts + $provider_exts) | map(if startswith("~/") then $home + .[1:] else . end)
         | reduce .[] as $e ([]; if index($e) then . else . + [$e] end)),
       fallback: $fallback}
  ' <<<"$1"
}

chain_entries() {
  jq -r --arg slot "$2" '
    [{label: $slot, harness: (.harness // ""), model: (.model // "")}]
    + [.fallback | to_entries[] | {label: "\($slot) fallback[\(.key)]", harness: (.value.harness // ""), model: (.value.model // "")}]
    | .[] | [.label, .harness, .model] | join("|")' <<<"$1"
}

check_harness() {
  case "$3" in
    pi|codex|zcode) ;;
    "") die "slot $2 has no harness in $1" ;;
    *) die "slot $2 has an unknown harness '$3' in $1" ;;
  esac
}

check_codex_role() {
  [[ "$4" == codex ]] || return 0
  [[ "$3" == scout || "$3" == reviewer || "$3" == worker ]] || die "slot $2: codex agents run as scout, reviewer or worker only ($1)"
}

[[ "${HERDR_ENV:-}" == 1 ]] || die "not inside Herdr (HERDR_ENV!=1)"

in_own_pane() {
  local shell pid=$$
  shell="$(herdr pane process-info --pane "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.process_info.shell_pid // empty')"
  [[ -n "$shell" ]] || return 1
  while (( pid > 1 )); do
    (( pid == shell )) && return 0
    pid="$(ps -o ppid= -p "$pid" | tr -d ' ')"
    [[ -n "$pid" ]] || return 1
  done
  return 1
}

in_own_pane || die "HERDR_PANE_ID=$HERDR_PANE_ID is not this process's pane: run hd from the pane that owns its agents"

digest() {
  if command -v md5sum >/dev/null 2>&1; then md5sum; else md5 -q; fi
}

LEAD_TAG="$(printf %s "$HERDR_PANE_ID" | digest | cut -c1-4)"

target() { echo "$1-$LEAD_TAG"; }

agent_target() {
  if [[ "$(agent_kind "$1")" == zcode ]]; then zcode_pane "$1"; else target "$1"; fi
}

run_dir() {
  local d="$RUN_ROOT/${HERDR_PANE_ID//[^A-Za-z0-9]/_}"
  mkdir -p "$d"
  echo "$d"
}

role_tools() {
  case "$1" in
    sidekick|worker) echo "read,grep,find,ls,bash,edit,write,tool_search" ;;
    scout|reviewer) echo "read,grep,find,ls,bash,write,tool_search" ;;
    researcher) echo "read,write,web_search,fetch_content,get_search_content,tool_search" ;;
    *) die "unknown role: $1" ;;
  esac
}

agent_json() { herdr agent get "$(agent_target "$1")"; }
agent_status() { agent_json "$1" | jq -r .result.agent.agent_status; }
agent_kind() { cat "$(run_dir)/$1.agent" 2>/dev/null || echo pi; }
agent_model() { cat "$(run_dir)/$1.model" 2>/dev/null || echo "$(agent_kind "$1") default"; }

agent_pane() {
  if [[ "$(agent_kind "$1")" == zcode ]]; then zcode_pane "$1"; else agent_json "$1" | jq -r .result.agent.pane_id; fi
}

tried_models() {
  local name="$1" rd
  rd="$(run_dir)"
  if [[ -f "$rd/$name.tried" ]]; then cat "$rd/$name.tried"; fi
  agent_model "$name"
}

tried_text() {
  local name="$1" model out=""
  while IFS= read -r model; do
    out="${out:+$out → }$model"
  done < <(tried_models "$name")
  printf '%s\n' "$out"
}

agent_session() {
  case "$(agent_kind "$1")" in
    codex) codex_session "$1" ;;
    zcode) echo "$(zcode_dir "$1")/events.jsonl" ;;
    *) agent_json "$1" | jq -r '.result.agent.agent_session.value // empty' ;;
  esac
}

codex_session() {
  local rd f=""; rd="$(run_dir)"
  [[ -f "$rd/$1.rollout" ]] && f="$(<"$rd/$1.rollout")"
  if [[ ! -f "$f" && -f "$rd/$1.out" && -d "$CODEX_SESSIONS" ]]; then
    f="$(find "$CODEX_SESSIONS" -name 'rollout-*.jsonl' -newer "$rd/$1.agent" \
      -exec grep -lF -- "$(<"$rd/$1.out")" {} + | head -n 1 || true)"
    [[ -n "$f" ]] && echo "$f" > "$rd/$1.rollout"
  fi
  echo "$f"
}

agent_ctx() {
  local session; session="$(agent_session "$1")"
  [[ "$(agent_kind "$1")" == zcode ]] && return 0
  [[ -f "$session" ]] || return 0
  if [[ "$(agent_kind "$1")" == codex ]]; then
    jq -rs '[.[] | select(.type == "event_msg" and .payload.type == "token_count") | .payload.info.last_token_usage | select(.)]
      | last | select(.) | "\((.input_tokens / 1000) | floor)k"' "$session"
    return
  fi
  jq -rs '[.[] | select(.type == "message" and .message.role == "assistant") | .message.usage | select(.)]
    | last | select(.) | "\(((.input + .cacheRead + .cacheWrite) / 1000) | floor)k"' "$session"
}

project_context_files() {
  local dir="$1" found=() f
  while :; do
    for f in AGENTS.override.md AGENTS.md AGENTS.MD CLAUDE.md CLAUDE.MD; do
      if [[ -f "$dir/$f" ]]; then found=("$dir/$f" "${found[@]}"); break; fi
    done
    [[ "$dir" == / ]] && break
    dir="$(dirname "$dir")"
  done
  if (( ${#found[@]} )); then printf '%s\0' "${found[@]}"; fi
}

project_context_args() {
  local f
  while IFS= read -r -d '' f; do
    printf '%s\0' --append-system-prompt "$f"
  done < <(project_context_files "$1")
}

agent_cwd() { cat "$(run_dir)/$1.cwd" 2>/dev/null || echo "$PWD"; }

# ponytail: git-ignored files (e.g. a gitignored lab/) are outside the snapshot; snapshot them separately if needed
snapshot_tree() {
  local dir="$1" idx
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || return 0
  idx="$(mktemp)"
  cp "$(git -C "$dir" rev-parse --path-format=absolute --git-path index)" "$idx" 2>/dev/null || rm -f "$idx"
  GIT_INDEX_FILE="$idx" git -C "$dir" add -A >/dev/null
  GIT_INDEX_FILE="$idx" git -C "$dir" write-tree
  rm -f "$idx"
}

agent_workspace() {
  local cwd="$1" lead top ws=""
  lead="${HERDR_WORKSPACE_ID:-$(herdr pane get "$HERDR_PANE_ID" | jq -r .result.pane.workspace_id)}"
  if top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)"; then
    ws="$(herdr workspace list 2>/dev/null | jq -r --arg top "$top" --arg lead "$lead" '
      [.result.workspaces[] | select(.worktree.checkout_path == $top) | .workspace_id]
      | if any(.[]; . == $lead) then $lead else (.[0] // empty) end' 2>/dev/null || true)"
  fi
  echo "${ws:-$lead}"
}

place_pane() {
  local rd="$1" cwd="$2" ws tab_file tab slot="" anchor dir res
  ws="$(agent_workspace "$cwd")"
  tab_file="$rd/tab-$ws"
  tab="$(cat "$tab_file" 2>/dev/null || true)"
  [[ -z "$tab" ]] || slot="$(herdr pane list --workspace "$ws" 2>/dev/null | jq -r --arg t "$tab" '
    [.result.panes[] | select(.tab_id == $t)]
    | if length == 1 then "\(.[0].pane_id) right"
      elif length == 2 or length == 3 then "\(sort_by(-(.scroll.viewport_rows // 0))[0].pane_id) down"
      else empty end' 2>/dev/null || true)"
  if [[ -n "$slot" ]]; then
    read -r anchor dir <<<"$slot"
    herdr pane split --pane "$anchor" --direction "$dir" --cwd "$cwd" --no-focus | jq -r .result.pane.pane_id
    return
  fi
  res="$(herdr tab create --workspace "$ws" --cwd "$cwd" --label "agents $(basename "$PWD")" --no-focus)"
  jq -r .result.tab.tab_id <<<"$res" > "$tab_file"
  jq -r .result.root_pane.pane_id <<<"$res"
}

cmd_spawn() {
  local name="${1:-}" slot="${2:-}"; shift 2 || usage
  [[ -n "$name" && -n "$slot" ]] || usage
  local cwd="$PWD" cli_agent="" cli_model="" cli_thinking="" session=""
  local have_agent=0 have_model=0 have_thinking=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent) cli_agent="$2"; have_agent=1; shift 2 ;;
      --cwd) cwd="$2"; shift 2 ;;
      --model) cli_model="$2"; have_model=1; shift 2 ;;
      --thinking) cli_thinking="$2"; have_thinking=1; shift 2 ;;
      --session) session="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  cwd="$(cd "$cwd" 2>/dev/null && pwd)" || die "no such directory: $cwd"

  local path body res chain role harness model thinking fallback
  local label entry_harness entry_model pi_chain catalog
  path="$(config_path)"
  body="$(config_json "$path")"
  slot_known "$body" "$slot" || die "unknown slot $slot in $path"
  res="$(resolve_slot "$body" "$slot" "$cli_agent" "$cli_model" "$cli_thinking" "$have_agent" "$have_model" "$have_thinking")"
  role="$(jq -r .role <<<"$res")"
  harness="$(jq -r .harness <<<"$res")"
  model="$(jq -r .model <<<"$res")"
  thinking="$(jq -r .thinking <<<"$res")"
  fallback="$(jq -c .fallback <<<"$res")"

  chain="$(chain_entries "$res" "$slot")"
  while IFS='|' read -r label entry_harness entry_model; do
    check_harness "$path" "$label" "$entry_harness"
    check_codex_role "$path" "$label" "$role" "$entry_harness"
    [[ -n "$entry_model" ]] || die "slot $label has no model in $path"
  done <<<"$chain"

  local role_file="$SKILL_DIR/roles/$role.md" tools
  [[ -f "$role_file" ]] || die "no role file: $role_file"
  tools="$(role_tools "$role")"

  local ext_args=(--no-extensions -e builtin:mcp -e builtin:tool-search) ext
  [[ -f "$PI_AGENT_DIR/extensions/herdr-agent-state.ts" ]] && ext_args+=(-e "$PI_AGENT_DIR/extensions/herdr-agent-state.ts")
  while IFS= read -r ext; do ext_args+=(-e "$ext"); done < <(jq -r '.extensions[]' <<<"$res")

  pi_chain="$(awk -F'|' '$2 == "pi" && $3 != ""' <<<"$chain")"
  if [[ -n "$pi_chain" ]]; then
    catalog="$(pi "${ext_args[@]}" --list-models 2>/dev/null)" || die "slot $slot: pi --list-models failed in $path"
    while IFS='|' read -r label entry_harness entry_model; do
      require_exact_pi_model "$entry_model" "$catalog" "slot $label ($path)"
    done <<<"$pi_chain"
  fi
  while IFS='|' read -r label entry_harness entry_model; do
    [[ "$entry_harness" == zcode ]] || continue
    zcode_valid_model "$entry_model" || die "slot $label: zcode model must be providerId/modelId ($path)"
  done <<<"$chain"
  local pi_count ext_count
  pi_count="$(awk -F'|' '$2 == "pi"' <<<"$chain" | wc -l | tr -d ' ')"
  ext_count="$(jq '.pi_extensions | length' <<<"$res")"
  if [[ "$role" == researcher && "$pi_count" -gt 0 && "$ext_count" -eq 0 ]]; then
    die "slot $slot runs researcher on pi without pi_extensions in $path"
  fi

  case "$harness" in
    pi) ;;
    codex) spawn_codex "$name" "$role" "$cwd" "$model" "$thinking" "$session" "$slot" "$fallback"; return ;;
    zcode) spawn_zcode "$name" "$role" "$cwd" "$model" "$thinking" "$session" "$slot" "$fallback"; return ;;
  esac

  local session_args=() model_args=(--model "$model") ctx_args=()
  [[ -n "$session" ]] && session_args=(--session "$session")
  [[ -n "$thinking" ]] && model_args+=(--thinking "$thinking")
  mapfile -d '' ctx_args < <(project_context_args "$(cd "$cwd" && pwd)")

  local rd pane
  rd="$(run_dir)"
  pane="$(place_pane "$rd" "$cwd")"
  record_spawn "$rd" "$pane" "$name" "$role" pi "$model" "$cwd" "$slot" "$thinking" "$fallback"

  start_agent "$name" pi "$pane" \
    "${ext_args[@]}" "${session_args[@]}" --no-context-files --no-skills --no-prompt-templates "${ctx_args[@]}" \
    "${model_args[@]}" --tools "$tools" \
    --append-system-prompt "$role_file" \
    --append-system-prompt "$SKILL_DIR/roles/_envelope.md"
  echo "spawned $name role=$role pane=$pane model=$model cwd=$cwd"
}

require_exact_pi_model() {
  local model="$1" catalog="$2" where="$3" provider id
  [[ "$model" =~ ^(.+):(off|minimal|low|medium|high|xhigh|max)$ ]] && model="${BASH_REMATCH[1]}"
  provider="${model%%/*}"
  id="${model#*/}"
  if awk -v p="$provider" -v i="$id" -v m="$model" '($1 == p && $2 == i) || $2 == m { found = 1 } END { exit !found }' <<<"$catalog"; then
    return 0
  fi
  die "$where: pi has no exact model $model (pi --model falls back to a fuzzy match); exact IDs containing ${model##*/}:
$(awk -v s="${model##*/}" 'NR > 1 && index($2, s) { print "  " $1 "/" $2 }' <<<"$catalog")"
}

record_spawn() {
  local rd="$1" pane="$2" name="$3" role="$4" kind="$5" model="$6" cwd="$7"
  local slot="${8:-$4}" thinking="${9:-}" fallback="${10:-[]}"
  echo "$role" > "$rd/$name.role"
  echo "$slot" > "$rd/$name.slot"
  echo "$kind" > "$rd/$name.agent"
  if [[ -n "$model" ]]; then echo "$model" > "$rd/$name.model"; else rm -f "$rd/$name.model"; fi
  printf '%s\n' "$thinking" > "$rd/$name.thinking"
  printf '%s\n' "$fallback" > "$rd/$name.fallback"
  echo "$cwd" > "$rd/$name.cwd"
}

start_agent() {
  local name="$1" kind="$2" pane="$3"; shift 3
  if ! herdr agent start "$name-$LEAD_TAG" --kind "$kind" --pane "$pane" --timeout 60000 -- "$@" >/dev/null; then
    echo "spawn: agent not ready; screen:" >&2
    herdr pane read "$pane" --source visible >&2 || true
    exit 1
  fi
}

# ponytail: codex runs scouts, reviewers and workers; sidekick and researcher need network and build caches, untried on codex
spawn_codex() {
  local name="$1" role="$2" cwd="$3" model="$4" thinking="${5:-}" session="$6"
  local slot="${7:-$2}" fallback="${8:-[]}"
  [[ "$role" == scout || "$role" == reviewer || "$role" == worker ]] || die "codex agents run as scout, reviewer or worker only"
  cwd="$(cd "$cwd" && pwd)"
  local rd pane args=() instructions sandbox effort=() effort_value="$thinking"
  rd="$(run_dir)"
  sandbox=(-s workspace-write --add-dir "$rd")
  [[ "$role" == worker ]] && sandbox=(-s danger-full-access)
  [[ "$effort_value" == max ]] && effort_value=xhigh
  [[ -n "$effort_value" ]] && effort=(-c "model_reasoning_effort=\"$effort_value\"")
  if [[ -n "$session" ]]; then
    args=(resume "$(jq -r 'select(.type == "session_meta") | .payload.id' "$session" | head -n 1)")
  fi
  instructions="$(cat "$SKILL_DIR/roles/$role.md" "$SKILL_DIR/roles/_envelope.md" | jq -Rs .)"
  args+=(-C "$cwd" "${sandbox[@]}" -a never "${effort[@]}"
    -c 'project_doc_fallback_filenames=["CLAUDE.md"]'
    -c "developer_instructions=$instructions")
  [[ -n "$model" ]] && args+=(-m "$model")

  pane="$(place_pane "$rd" "$cwd")"
  record_spawn "$rd" "$pane" "$name" "$role" codex "$model" "$cwd" "$slot" "$thinking" "$fallback"
  if [[ -n "$session" ]]; then echo "$session" > "$rd/$name.rollout"; else rm -f "$rd/$name.rollout" "$rd/$name.out"; fi
  start_agent "$name" codex "$pane" "${args[@]}"
  echo "spawned $name role=$role agent=codex pane=$pane model=$(agent_model "$name") thinking=$thinking cwd=$cwd"
}

session_mark_read() {
  local file="$1" first="" second=""
  if [[ -f "$file" ]]; then
    { IFS= read -r first; IFS= read -r second; } < "$file" || true
  fi
  if [[ "$second" =~ ^[0-9]+$ ]]; then
    printf '%s\0%s\0' "$first" "$second"
  elif [[ "$first" =~ ^(.*)[[:space:]]([0-9]+)$ ]]; then
    printf '%s\0%s\0' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  else
    printf '%s\0%s\0' "$first" "0"
  fi
}

new_entries() {
  local name="$1" rd session mark_file mark_session offset
  rd="$(run_dir)"
  session="$(agent_session "$name")"
  [[ -n "$session" && -f "$session" ]] || die "no session file for $name"
  mark_file="$rd/$name.mark"
  offset=0
  if [[ -f "$mark_file" ]]; then
    { IFS= read -r -d '' mark_session; IFS= read -r -d '' offset; } < <(session_mark_read "$mark_file")
    [[ "$offset" =~ ^[0-9]+$ ]] || offset=0
    [[ "$mark_session" == "$session" ]] || offset=0
  fi
  tail -n "+$((offset + 1))" "$session"
}

provider_error() {
  if [[ "$(agent_kind "$1")" == zcode ]]; then zcode_provider_error "$1"; return; fi
  if [[ "$(agent_kind "$1")" == codex ]]; then
    new_entries "$1" | jq -rs '
      [.[] | select(.type == "event_msg" and (.payload.type == "error" or .payload.type == "task_complete")) | .payload]
      | last | select(.type == "error") | .message // "unknown error"'
    return
  fi
  new_entries "$1" | jq -rs '
    [.[] | select(.type == "message" and .message.role == "assistant")] | last
    | select(.message.stopReason == "error") | .message.errorMessage // "unknown error"'
}

reply_text() {
  if [[ "$(agent_kind "$1")" == zcode ]]; then zcode_reply_text "$1"; return; fi
  if [[ "$(agent_kind "$1")" == codex ]]; then
    new_entries "$1" | jq -rs '
      [.[] | select(.type == "event_msg" and .payload.type == "task_complete") | .payload.last_agent_message // empty]
      | last // empty'
    return
  fi
  new_entries "$1" | jq -rs '
    [.[] | select(.type == "message" and .message.role == "assistant")]
    | map((.message.content // []) | map(select(.type == "text") | .text) | join("\n"))
    | map(select(length > 0)) | last // empty'
}

screen_tail() {
  local name="$1"
  if [[ "$(agent_kind "$name")" == zcode ]]; then
    zcode_screen_tail "$name"
  else
    herdr agent read "$(agent_target "$name")" --source recent-unwrapped --lines 40
  fi
}

zcode_print_exit() {
  local name="$1"
  echo "STATUS: tui_exited"
  echo "ZCode TUI exited before the turn completed; marker: $(zcode_exit_file "$name") ($(zcode_launcher_exit "$name")); diagnostics: $(zcode_dir "$name")/log"
  echo "--- screen tail:"
  screen_tail "$name"
}

print_result() {
  local name="$1" text
  text="$(reply_text "$name")"
  if [[ -z "$text" ]]; then
    echo "STATUS: no_reply"
    echo "--- screen tail:"
    screen_tail "$name"
    return
  fi
  printf '%s\n' "$text"
  echo "ctx=$(agent_ctx "$name")"
}

dispatch_prompt() {
  local name="$1" message="$2" timeout="$3" tag="$4"
  if [[ "$(agent_kind "$name")" == zcode ]]; then
    zcode_new_request "$name" "$message" "$tag"
    zcode_send_line "$name"
    zcode_wait_turn "$name" "$timeout"
    return 0
  fi
  herdr agent prompt "$(agent_target "$name")" "$message" --wait --timeout "$timeout" 2>&1
}

dispatch_wait() {
  local name="$1" timeout="$2"
  if [[ "$(agent_kind "$name")" == zcode ]]; then
    zcode_wait_turn "$name" "$timeout"
    return 0
  fi
  herdr agent wait "$(agent_target "$name")" --timeout "$timeout" >/dev/null 2>&1
}

ask_message() {
  printf '%s\n\n---\nOUTPUT_FILE: %s\nWrite the payload your role defines to OUTPUT_FILE. End your turn with the report envelope from your role instructions.\n' "$1" "$2"
}

cmd_ask() {
  local name="${1:-}" brief="${2:-}"; shift 2 || usage
  [[ -n "$name" && -n "$brief" ]] || usage
  local timeout=3000000
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) timeout="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  if [[ "$brief" == @* ]]; then
    brief="$(cat "${brief#@}")"
  fi
  local check red_field
  check="$(sed -n '/^Check:/{s/^Check:[[:space:]]*//;s/^`\([^`]*\)`.*/\1/;s/[[:space:]]*$//;p;q;}' <<<"$brief")"
  red_field="$(sed -n '/^Red:/{s/^Red:[[:space:]]*//;s/^`\([^`]*\)`.*/\1/;s/[[:space:]]*$//;p;q;}' <<<"$brief")"
  [[ -z "$check" || -n "$CHECK_TIMEOUT" ]] || die "Check needs timeout or gtimeout (macOS: brew install coreutils)"

  if [[ "$name" == sk ]] && ! agent_json sk >/dev/null 2>&1; then
    cmd_spawn sk sidekick
  fi

  local status
  status="$(agent_status "$name")"
  [[ "$status" == idle || "$status" == done ]] || die "$name is $status, not ready for input"
  if [[ "$(agent_kind "$name")" == codex ]]; then
    local pane screen
    pane="$(agent_json "$name" | jq -r .result.agent.pane_id)"
    if screen="$(herdr pane read "$pane" --source visible)" &&
      grep -qiE 'hooks? needs? review|trust this folder\?' <<<"$screen"; then
      echo "STATUS: blocked_ui"
      echo "codex shows a startup dialog in pane $pane; answer it there once the user agrees, then hd ask again"
      grep -v '^[[:space:]]*$' <<<"$screen" | tail -n 15
      return
    fi
  fi
  if [[ "$(agent_kind "$name")" == zcode ]] && zcode_in_flight "$name"; then
    die "$name has an ask in flight; continue with: hd wait $name"
  fi

  local rd role seq out session head_commit restored root
  rd="$(run_dir)"
  if [[ -f "$rd/$name.red/list" ]]; then
    root="$(git -C "$(agent_cwd "$name")" rev-parse --show-toplevel)"
    restored="$(restore_red "$root" "$rd/$name.red")"
    printf "hd: restored %s files from an interrupted red run\n" "$restored"
  fi
  role="$(cat "$rd/$name.role" 2>/dev/null || echo unknown)"
  seq=$(( $(find "$rd" -maxdepth 1 -name "$name-*.md" | wc -l) + 1 ))
  out="$rd/$name-$(printf '%02d' "$seq").md"
  session="$(agent_session "$name")"
  rm -f "$rd/$name.retried"
  rm -f "$rd/$name.tried"
  rm -f "$rd/$name.tried-errors"
  rm -f "$rd/$name.autofix"
  if head_commit="$(git -C "$(agent_cwd "$name")" rev-parse HEAD 2>/dev/null)"; then
    printf '%s\n' "$head_commit" > "$rd/$name.head"
  else
    rm -f "$rd/$name.head"
  fi
  echo "$out" > "$rd/$name.out"
  printf '%s\n' "$brief" > "${out%.md}.brief"
  printf '%s' "$check" > "$rd/$name.check"
  if [[ "$red_field" == skip ]]; then
    touch "$rd/$name.red-skip"
  else
    rm -f "$rd/$name.red-skip"
  fi
  sed -n '/^Scope:/{p;q;}' <<<"$brief" | grep -o '`[^`]*`' | tr -d '`' | sed 's|^\./||' > "$rd/$name.scope" || true
  snapshot_tree "$(agent_cwd "$name")" > "$rd/$name.base" || rm -f "$rd/$name.base"
  date +%s > "$rd/$name.ask-start"
  rm -f "$rd/$name.ask-end"
  local mark_offset=0
  [[ -f "$session" ]] && mark_offset="$(wc -l < "$session")"
  mark_offset="${mark_offset//[[:space:]]/}"
  printf '%s\n%s\n' "$session" "$mark_offset" > "$rd/$name.mark"

  local msg
  msg="$(ask_message "$brief" "$out")"

  local rc=0 res
  res="$(dispatch_prompt "$name" "$msg" "$timeout" "${out##*/}")" || rc=$?
  if [[ $rc -ne 0 ]]; then
    if grep -q timeout <<<"$res"; then
      echo "STATUS: still_working"
      echo "$name has not finished; continue with: hd wait $name"
      exit 0
    fi
    echo "$res" >&2
    exit "$rc"
  fi
  if [[ "$(agent_kind "$name")" == zcode && "$res" == timeout ]]; then
    echo "STATUS: still_working"
    echo "$name has not finished; continue with: hd wait $name"
    exit 0
  fi
  finish "$name" "$timeout"
}

finish() {
  settle_ask "$@"
  [[ "$(agent_status "$1" 2>/dev/null)" == blocked ]] || date +%s > "$(run_dir)/$1.ask-end"
}

reply_done() {
  local text line
  text="$(reply_text "$1")"
  line="$(grep -m1 -E 'STATUS|СТАТУС' <<<"$text" || true)"
  [[ -n "$line" ]] || return 1
  grep -qiE 'done|готово' <<<"$line"
}

answer_turn() {
  local name="$1" msg="$2" timeout="$3" tag="$4" note="$5" rc=0 res
  res="$(dispatch_prompt "$name" "$msg" "$timeout" "$tag")" || rc=$?
  if [[ "$(agent_kind "$name")" == zcode ]]; then
    if [[ -f "$(zcode_exit_file "$name")" ]]; then
      zcode_print_exit "$name"
      return 0
    fi
    if [[ $rc -ne 0 || "$res" == timeout ]]; then
      echo "STATUS: still_working"
      echo "$name $note; continue with: hd wait $name"
      exit 0
    fi
  elif [[ $rc -ne 0 ]]; then
    if grep -q timeout <<<"$res"; then
      echo "STATUS: still_working"
      echo "$name $note; continue with: hd wait $name"
      exit 0
    fi
    echo "$res" >&2
    exit "$rc"
  fi
  finish "$name" "$timeout"
}

fallback_ready() {
  local name="$1" rd
  rd="$(run_dir)"
  [[ -s "$rd/$name.out" ]] || return 1
  jq -e 'type == "array" and length > 0' "$rd/$name.fallback" >/dev/null 2>&1
}

fallback_refusal() {
  local name="$1" rd slot role config body
  rd="$(run_dir)"
  slot="$(cat "$rd/$name.slot" 2>/dev/null || cat "$rd/$name.role")"
  role="$(cat "$rd/$name.role" 2>/dev/null || true)"
  config="$(config_path)"
  if body="$(config_json "$config" 2>/dev/null)" && slot_known "$body" "$slot" &&
    [[ "$(resolve_slot "$body" "$slot" "" "" "" 0 0 0 | jq -r .role)" == "$role" ]]; then
    return 1
  fi
  printf 'fallback skipped: slot %s no longer resolves to role %s in %s\n' "$slot" "$role" "$config"
}

fallback_switch() {
  local name="$1" err="$2" rd list entry rest harness model thinking old out slot cwd pane n zdir
  rd="$(run_dir)"
  list="$(<"$rd/$name.fallback")"
  entry="$(jq -c '.[0]' <<<"$list")"
  rest="$(jq -c '.[1:]' <<<"$list")"
  harness="$(jq -r '.harness // ""' <<<"$entry")"
  model="$(jq -r '.model // ""' <<<"$entry")"
  thinking="$(jq -r '.thinking // ""' <<<"$entry")"
  old="$(agent_model "$name")"
  out="$(<"$rd/$name.out")"
  pane="$(agent_pane "$name" 2>/dev/null)" || pane=""
  printf '%s\n' "$old" >> "$rd/$name.tried"
  n="$(grep -c '' "$rd/$name.tried")"
  zdir="$(zcode_dir "$name")"
  if [[ "$(agent_kind "$name")" == zcode && -d "$zdir/log" ]]; then
    mv -- "$zdir/log" "$rd/$name.zcode-log-$n"
    err="${err/"$zdir/log"/"$rd/$name.zcode-log-$n"}"
  fi
  printf -- '--- fallback: %s → %s: %s\n' "$old" "$model" "$err"
  printf '%s\n' "${err//$'\n'/ }" >> "$rd/$name.tried-errors"
  [[ -z "$pane" ]] || herdr pane close "$pane" >/dev/null
  cmd_spawn "$name" "$(cat "$rd/$name.slot" 2>/dev/null || cat "$rd/$name.role")" --cwd "$(agent_cwd "$name")" \
    --agent "$harness" --model "$model" --thinking "$thinking" >/dev/null
  printf '%s\n' "$rest" > "$rd/$name.fallback"
  printf '%s\n' "$out" > "$rd/$name.out"
  rm -f "$rd/$name.mark" "$rd/$name.retried"
}

fallback_message() {
  local name="$1" rd out
  rd="$(run_dir)"
  out="$(<"$rd/$name.out")"
  printf 'A previous attempt at this brief ended on a provider error on another model. The working tree may hold its unfinished changes: check git status and git diff before you start.\n\n%s\n' \
    "$(ask_message "$(<"${out%.md}.brief")" "$out")"
}

settle_ask() {
  local name="$1" timeout="$2" status err rd settled retry_rc=0 res skip=""
  rd="$(run_dir)"
  if [[ "$(agent_kind "$name")" == zcode ]]; then
    settled="$(cat "$(zcode_settled_file "$name")" 2>/dev/null || true)"
    if [[ "$settled" == cancelled ]]; then
      echo "STATUS: cancelled"
      echo "--- screen tail:"
      screen_tail "$name"
      return
    fi
    if [[ "$settled" != completed && -f "$(zcode_exit_file "$name")" ]]; then
      zcode_print_exit "$name"
      return
    fi
  fi
  if [[ "$(agent_kind "$name")" == zcode && "$settled" == completed ]]; then
    status=""
  else
    status="$(agent_status "$name")"
  fi
  if [[ "$status" == blocked ]]; then
    echo "STATUS: blocked_ui"
    echo "--- screen tail:"
    screen_tail "$name"
    return
  fi
  err="$(provider_error "$name")"
  if [[ -n "$err" ]]; then
    if [[ -f "$rd/$name.retried" ]]; then
      if fallback_ready "$name"; then
        skip="$(fallback_refusal "$name")" || skip=""
        if [[ -z "$skip" ]]; then
          fallback_switch "$name" "$err"
          answer_turn "$name" "$(fallback_message "$name")" "$timeout" fallback "moved to a fallback model"
          return
        fi
      fi
      echo "STATUS: provider_error"
      echo "$err (already retried once; check the working tree, then re-ask or re-brief)"
      echo "agent=$(agent_kind "$name") model=$(agent_model "$name")"
      echo "models tried: $(tried_text "$name")"
      [[ -z "$skip" ]] || printf '%s\n' "$skip"
      return
    fi
    touch "$rd/$name.retried"
    answer_turn "$name" "Previous turn died on a provider error ($err). Continue the same task from where you stopped, then end with the report envelope." "$timeout" retry "was retried after a provider error"
    return
  fi
  local check_block scope_block claims_block concurrent_block red_block red_files rounds=0 check_rc="" outside=""
  local check_fail=0 outside_fail=0 red_fail=0 red_rc=0 reason="" msg scope_files
  local cited=0 bad=0 absent=0 found=0 claims=null claims_reason= details=()
  check_block="$(run_check "$name")"
  scope_block="$(run_scope "$name")"
  concurrent_block="$(run_concurrent "$name")"
  claims_block="$(run_claims "$name")"
  set +e
  red_block="$(set -e; run_red "$name" 2>&1)"
  red_rc=$?
  set -e
  if (( red_rc )); then
    rm -f "$rd/$name.red-exit"
    red_block="--- red: error exit=$red_rc"$'\n'"$red_block"
  fi
  if [[ -n "$claims_block" ]]; then
    {
      read -r cited bad absent found
      mapfile -t details
    } < "$rd/$name.claims"
    claims="{\"cited\":$cited,\"bad\":$bad,\"absent\":$absent,\"found\":$found}"
  fi
  if [[ -f "$rd/$name.autofix" ]]; then rounds="$(<"$rd/$name.autofix")"; fi
  [[ "$rounds" =~ ^[0-9]+$ ]] || rounds=0
  if [[ -f "$rd/$name.check-exit" ]]; then check_rc="$(<"$rd/$name.check-exit")"; fi
  if [[ -f "$rd/$name.outside" ]]; then outside="$(<"$rd/$name.outside")"; fi
  if [[ -n "$check_rc" && "$check_rc" != 0 ]]; then check_fail=1; fi
  if [[ -n "$outside" && -s "$rd/$name.scope" && ! -f "$rd/$name.concurrent" ]]; then outside_fail=1; fi
  if [[ -f "$rd/$name.red-exit" && "$(<"$rd/$name.red-exit")" == 0 ]]; then red_fail=1; fi
  if reply_done "$name" && (( rounds < 2 && (check_fail || outside_fail || bad || found || red_fail) )); then
    rounds=$((rounds + 1))
    printf '%s\n' "$rounds" > "$rd/$name.autofix"
    if (( check_fail )); then reason="check exit=$check_rc"; fi
    if (( outside_fail )); then
      if [[ -n "$reason" ]]; then reason+="; "; fi
      reason+="outside Scope: ${outside//$'\n'/ }"
    fi
    if (( bad || found )); then
      if (( bad )); then claims_reason="$bad not found"; fi
      if (( bad && found )); then claims_reason+=", "; fi
      if (( found )); then claims_reason+="$found absent found"; fi
      reason+="${reason:+; }claims: $claims_reason"
    fi
    if (( red_fail )); then
      reason+="${reason:+; }red: tests pass without the implementation"
    fi
    echo "--- autofix $rounds/2: $reason"
    msg="hd checked your turn and a gate failed."
    if (( check_fail )); then
      msg+=$'\n'"Check \`$(cat "$rd/$name.check")\` exited $check_rc. Last 40 lines of its output:"
      msg+=$'\n'"$(tail -n 40 "$rd/$name.check-out")"
    fi
    if (( outside_fail )); then
      scope_files="$(paste -sd' ' "$rd/$name.scope")"
      msg+=$'\n'"Files changed outside Scope: ${outside//$'\n'/ }. Scope: $scope_files. Revert those files; if the brief requires them, say so under QUESTION."
    fi
    if (( bad )); then
      msg+=$'\n'"These citations in OUTPUT_FILE do not match the file:"
      msg+=$'\n'"$(printf '%s\n' "${details[@]:0:bad}")"
    fi
    if (( found )); then
      msg+=$'\n'"These ABSENT strings occur in the repository:"
      msg+=$'\n'"$(printf '%s\n' "${details[@]:bad}")"
    fi
    if (( bad || found )); then
      msg+=$'\n'"Correct each line number or quote, or drop the claim. For an ABSENT string that occurs, replace the ABSENT line with the occurrences and why each does not count."
    fi
    if (( red_fail )); then
      red_files="${red_block#--- red: Check passes with the implementation reverted: }"
      msg+=$'\n'"Check passes with your implementation files reverted to their state at the start of this ask: $red_files. The Acceptance tests must fail without the change: make them exercise the new behavior, keep each case as the brief gives it, and say under QUESTION if a case cannot fail without the change."
    fi
    msg+=$'\n'"Fix it within the same brief and Scope, update OUTPUT_FILE $(cat "$rd/$name.out"), then end your turn with the report envelope."
    res="$(dispatch_prompt "$name" "$msg" "$timeout" autofix)" || retry_rc=$?
    if [[ "$(agent_kind "$name")" == zcode ]]; then
      if [[ -f "$(zcode_exit_file "$name")" ]]; then
        zcode_print_exit "$name"
        return
      fi
      if [[ $retry_rc -ne 0 || "$res" == timeout ]]; then
        echo "STATUS: still_working"
        echo "$name was sent an autofix round; continue with: hd wait $name"
        exit 0
      fi
    elif [[ $retry_rc -ne 0 ]]; then
      echo "STATUS: still_working"
      echo "$name was sent an autofix round; continue with: hd wait $name"
      exit 0
    fi
    finish "$name" "$timeout"
    return
  fi
  print_result "$name"
  if [[ -n "$check_block" ]]; then printf '%s\n' "$check_block"; fi
  if [[ -n "$red_block" ]]; then printf '%s\n' "$red_block"; fi
  if [[ -n "$scope_block" ]]; then printf '%s\n' "$scope_block"; fi
  if [[ -n "$claims_block" ]]; then printf '%s\n' "$claims_block"; fi
  if [[ -n "$concurrent_block" ]]; then printf '%s\n' "$concurrent_block"; fi
  journal_ask "$name" "$claims"
}

run_check() {
  local name="$1" check out rc=0 rd
  rd="$(run_dir)"
  rm -f "$rd/$name.check-exit"
  check="$(cat "$rd/$name.check" 2>/dev/null || true)"
  [[ -n "$check" ]] || return 0
  out="$(cd "$(agent_cwd "$name")" && "$CHECK_TIMEOUT" 600 bash -o pipefail -c "$check" 2>&1)" || rc=$?
  echo "$rc" > "$rd/$name.check-exit"
  printf '%s\n' "$out" > "$rd/$name.check-out"
  printf -- '--- check: %s\nexit=%s\n' "$check" "$rc"
  tail -n 20 <<<"$out"
}

run_scope() {
  local name="$1" rd base cwd role f p inside changed=() scope=() outside=()
  rd="$(run_dir)"
  rm -f "$rd/$name.changed" "$rd/$name.outside"
  base="$(cat "$rd/$name.base" 2>/dev/null || true)"
  [[ -n "$base" ]] || return 0
  role="$(cat "$rd/$name.role" 2>/dev/null || true)"
  cwd="$(agent_cwd "$name")"
  mapfile -t changed < <(git -C "$cwd" -c core.quotePath=false diff --no-renames --name-only "$base" "$(snapshot_tree "$cwd")")
  printf '%s\n' "${changed[@]}" | sed '/^$/d' > "$rd/$name.changed"
  if [[ ! -s "$rd/$name.scope" ]]; then
    [[ "$role" == reviewer && ${#changed[@]} -gt 0 ]] || return 0
  fi
  mapfile -t scope < "$rd/$name.scope"
  for f in "${changed[@]}"; do
    inside=0
    for p in "${scope[@]}"; do
      if [[ "$f" == $p || ( "$p" == */ && "$f" == "$p"* ) ]]; then inside=1; break; fi
    done
    (( inside )) || outside+=("$f")
  done
  printf '%s\n' "${outside[@]}" | sed '/^$/d' > "$rd/$name.outside"
  printf -- '--- scope: %s changed, %s outside Scope\n' "${#changed[@]}" "${#outside[@]}"
  [[ ${#outside[@]} -eq 0 ]] || printf '%s\n' "${outside[@]}"
}

restore_red() {
  local root="$1" red="$2" entry kind path backup count=0 failed=0
  while IFS= read -r entry; do
    kind="${entry%%$'\t'*}"
    path="${entry#*$'\t'}"
    backup="$red/files/$path"
    case "$kind" in
      modified|added)
        if [[ ! -f "$backup" && ! -L "$backup" ]] ||
          ! mkdir -p -- "$root/$(dirname -- "$path")" || ! rm -f -- "$root/$path" ||
          ! cp -pP -- "$backup" "$root/$path"; then
          failed=1
          continue
        fi
        if [[ -L "$backup" ]]; then
          [[ -L "$root/$path" ]] &&
            cmp -s <(readlink -- "$backup") <(readlink -- "$root/$path") || failed=1
        else
          cmp -s -- "$backup" "$root/$path" || failed=1
        fi
        ;;
      deleted)
        rm -f -- "$root/$path" || failed=1
        ;;
    esac
    count=$((count + 1))
  done < "$red/list"
  if (( failed )); then
    printf -- '--- red: WARNING restore mismatch, backups in %s\n' "$red" >&2
    return 1
  fi
  rm -rf -- "$red" || return 1
  printf '%s\n' "$count"
}

# ponytail: red runs the whole Check; per-case red needs a test selector per Acceptance case
run_red() {
  local name="$1" rd cwd root base red entry path mode kind parent ancestor check out rc=0 tests=0 target
  local files=()
  rd="$(run_dir)"
  red="$rd/$name.red"
  rm -f "$rd/$name.red-exit" "$rd/$name.red-out"
  [[ "$(cat "$rd/$name.role" 2>/dev/null || true)" == worker &&
     "$(cat "$rd/$name.check-exit" 2>/dev/null || true)" == 0 &&
     ! -e "$rd/$name.concurrent" && ! -e "$rd/$name.red-skip" &&
     -s "$rd/$name.changed" ]] || return 0
  reply_done "$name" || return 0
  while IFS= read -r path; do
    case "/${path%/*}/" in
      */test/*|*/tests/*|*/__tests__/*|*/spec/*|*/testdata/*)
        if [[ "$path" == */* ]]; then tests=1; continue; fi
        ;;
    esac
    case "${path##*/}" in
      *_test.*|*.test.*|*.spec.*|*-spec.*|test_*|*Test.*|*Tests.*) tests=1 ;;
      *.md) ;;
      *) files+=("$path") ;;
    esac
  done < "$rd/$name.changed"
  (( tests && ${#files[@]} )) || return 0

  cwd="$(agent_cwd "$name")"
  root="$(git -C "$cwd" rev-parse --show-toplevel)"
  base="$(<"$rd/$name.base")"
  check="$(<"$rd/$name.check")"
  [[ ! -e "$red/list" ]] || die "interrupted red run at $red"
  (
    trap 'if [[ -f "$red/list" ]]; then restore_red "$root" "$red" >/dev/null || exit 1; else rm -rf -- "$red"; fi' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    rm -rf -- "$red"
    mkdir -p -- "$red"
    : > "$red/pending"
    for path in "${files[@]}"; do
      parent="$(dirname -- "$path")"
      ancestor="$parent"
      while [[ "$ancestor" != . ]]; do
        [[ ! -L "$root/$ancestor" ]] || die "cannot revert $path through symlink $ancestor"
        ancestor="$(dirname -- "$ancestor")"
      done
      [[ ! -d "$root/$path" || -L "$root/$path" ]] || die "cannot revert directory $path as a file"
      mode="$(git -C "$root" ls-tree "$base" -- ":(literal)$path" | cut -d' ' -f1)"
      case "$mode" in
        '') kind=added ;;
        100644|100755|120000)
          kind=deleted
          if [[ -f "$root/$path" || -L "$root/$path" ]]; then kind=modified; fi
          mkdir -p -- "$red/base/$parent"
          if [[ "$mode" == 120000 ]]; then
            target="$(git -C "$root" cat-file blob "$base:$path" && printf .)"
            ln -s -- "${target%.}" "$red/base/$path"
          else
            git -C "$root" cat-file blob "$base:$path" > "$red/base/$path"
            chmod "${mode: -3}" "$red/base/$path"
          fi
          ;;
        *) die "cannot revert $path with git mode $mode" ;;
      esac
      if [[ "$kind" != deleted ]]; then
        mkdir -p -- "$red/files/$parent"
        cp -pP -- "$root/$path" "$red/files/$path"
      fi
      printf '%s\t%s\n' "$kind" "$path" >> "$red/pending"
    done
    mv -- "$red/pending" "$red/list"
    while IFS= read -r entry; do
      kind="${entry%%$'\t'*}"
      path="${entry#*$'\t'}"
      rm -f -- "$root/$path"
      if [[ "$kind" != added ]]; then
        mkdir -p -- "$root/$(dirname -- "$path")"
        cp -pP -- "$red/base/$path" "$root/$path"
      fi
    done < "$red/list"

    out="$(cd "$cwd" && "$CHECK_TIMEOUT" 600 bash -o pipefail -c "$check" 2>&1)" || rc=$?
    printf '%s\n' "$out" > "$rd/$name.red-out"
    printf '%s\n' "$rc" > "$rd/$name.red-exit"
  )
  if (( $(<"$rd/$name.red-exit") )); then
    printf -- "--- red: Check exit=%s with %s implementation files at the ask's start\n" "$(<"$rd/$name.red-exit")" "${#files[@]}"
  else
    printf -- '--- red: Check passes with the implementation reverted: %s\n' "${files[*]}"
  fi
}

claim_matches() {
  local in_git="$1" string="$2" path number rest count=0
  if [[ "$in_git" == true ]]; then
    while (( count < 10 )) && IFS= read -r -d '' path && IFS= read -r -d '' number && IFS= read -r rest; do
      printf '%s:%s\n' "$path" "$number"
      count=$((count + 1))
    done < <(git grep -n -I -F -z -e "$string")
  else
    while (( count < 10 )) && IFS= read -r -d '' path && IFS= read -r rest; do
      printf '%s:%s\n' "$path" "${rest%%:*}"
      count=$((count + 1))
    done < <(grep -rnIF -Z --exclude-dir=.git -e "$string" .)
  fi
}

run_claims() {
  local name="$1" rd out cwd in_git line rest cite path start end quote normalized window reason string
  local cited=0 bad=0 absent=0 found=0 bad_lines=() found_lines=() preview=() matches=() match i
  local token='`([^`]*)`' location='^(.+):([0-9]+)((-|–)([0-9]+))?$'
  local quoted='^[[:space:]]*(—|–|-|:|·)[[:space:]]*`([^`]*)`'
  local missing='ABSENT:[[:blank:]]+`([^`]+)`'
  local trim='s/[[:space:]]+//g' lineref='^:?[0-9]+((-|–)[0-9]+)?$'
  rd="$(run_dir)"
  rm -f "$rd/$name.claims"
  case "$(cat "$rd/$name.role" 2>/dev/null || true)" in
    scout|reviewer) ;;
    *) return 0 ;;
  esac
  out="$(cat "$rd/$name.out" 2>/dev/null || true)"
  [[ -f "$out" ]] || return 0
  cwd="$(agent_cwd "$name")"
  in_git="$(git -C "$cwd" rev-parse --is-inside-work-tree 2>/dev/null || true)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    rest="$line"
    while [[ "$rest" =~ $token ]]; do
      rest="${rest#*"${BASH_REMATCH[0]}"}"
      cite="${BASH_REMATCH[1]}"
      [[ "$cite" =~ $location ]] || continue
      path="${BASH_REMATCH[1]}" start="${BASH_REMATCH[2]}" end="${BASH_REMATCH[5]:-${BASH_REMATCH[2]}}"
      [[ "$rest" =~ $quoted ]] || continue
      quote="${BASH_REMATCH[2]}"
      rest="${rest#"${BASH_REMATCH[0]}"}"
      [[ "$quote" =~ $lineref ]] && continue
      cited=$((cited + 1))
      [[ "$path" == /* ]] || path="$cwd/$path"
      if [[ ! -f "$path" ]]; then
        reason="no such file"
      else
        normalized="$(sed -E "s/(\.\.\.|…)[[:space:]]*$//; $trim" <<<"$quote")"
        window="$(awk -v start="$start" -v end="$end" '
          NR > end + 3 { exit }
          NR >= start - 3 { printf "%s ", $0 }
        ' < "$path" | sed -E "$trim")"
        [[ -n "$window" && "$window" == *"$normalized"* ]] && continue
        reason="not within 3 lines"
      fi
      bad=$((bad + 1))
      bad_lines+=("  $cite \`$quote\`: $reason")
    done
    rest="$line"
    while [[ "$rest" =~ $missing ]]; do
      string="${BASH_REMATCH[1]}"
      rest="${rest#*"${BASH_REMATCH[0]}"}"
      absent=$((absent + 1))
      mapfile -t matches < <(cd "$cwd" && claim_matches "$in_git" "$string")
      (( ${#matches[@]} )) || continue
      found=$((found + 1))
      match="  ABSENT \`$string\`: ${matches[0]}"
      for ((i=1; i<${#matches[@]}; i++)); do
        if (( i == 5 )); then preview+=("$match"); fi
        match+=", ${matches[i]}"
      done
      if (( i <= 5 )); then preview+=("$match"); fi
      found_lines+=("$match")
    done
  done < "$out"
  {
    printf '%s %s %s %s\n' "$cited" "$bad" "$absent" "$found"
    if (( bad || found )); then printf '%s\n' "${bad_lines[@]}" "${found_lines[@]}"; fi
  } > "$rd/$name.claims"
  printf -- '--- claims: %s cited, %s not found; %s absent, %s found in repo\n' "$cited" "$bad" "$absent" "$found"
  if (( bad || found )); then printf '%s\n' "${bad_lines[@]:0:10}" "${preview[@]}"; fi
}

tree_root() { git -C "$1" rev-parse --show-toplevel 2>/dev/null || echo "$1"; }

run_concurrent() {
  local name="$1" rd root start f other others=()
  rd="$(run_dir)"
  rm -f "$rd/$name.concurrent"
  root="$(tree_root "$(agent_cwd "$name")")"
  start="$(cat "$rd/$name.ask-start" 2>/dev/null || echo 0)"
  for f in "$rd"/*.ask-start; do
    [[ -e "$f" ]] || continue
    other="$(basename "$f" .ask-start)"
    [[ "$other" != "$name" && "$(tree_root "$(agent_cwd "$other")")" == "$root" ]] || continue
    [[ ! -f "$rd/$other.ask-end" ]] || (( $(cat "$rd/$other.ask-end") >= start )) || continue
    others+=("$other")
  done
  (( ${#others[@]} )) || return 0
  printf '%s\n' "${others[@]}" > "$rd/$name.concurrent"
  printf -- '--- concurrent: %s asked in this tree during this ask; changed files may be theirs\n' "${others[*]}"
}

journal_lines() { if [[ -f "$1" ]]; then jq -Rn '[inputs]' < "$1"; else echo '[]'; fi; }

journal_ask() {
  local name="$1" claims="$2" rd out cwd autofix
  rd="$(run_dir)"
  out="$(cat "$rd/$name.out" 2>/dev/null || true)"
  cwd="$(agent_cwd "$name")"
  autofix="$(cat "$rd/$name.autofix" 2>/dev/null || echo 0)"
  [[ "$autofix" =~ ^[0-9]+$ ]] || autofix=0
  jq -nc --arg ts "$(date +%Y-%m-%dT%H:%M:%S%z)" --arg project "$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || echo "$cwd")" \
    --arg name "$name" --arg role "$(cat "$rd/$name.role" 2>/dev/null || echo unknown)" \
    --arg agent "$(agent_kind "$name")" --arg model "$(agent_model "$name")" \
    --argjson models "$(tried_models "$name" | jq -Rn '[inputs]')" \
    --argjson fallback_errors "$(journal_lines "$rd/$name.tried-errors")" \
    --arg brief "${out%.md}.brief" --arg payload "$out" \
    --arg status "$(reply_text "$name" | grep -m1 -E 'STATUS' || true)" \
    --argjson autofix "$autofix" \
    --argjson claims "$claims" \
    --arg head "$(cat "$rd/$name.head" 2>/dev/null || true)" \
    --arg base "$(cat "$rd/$name.base" 2>/dev/null || true)" \
    --arg check "$(cat "$rd/$name.check" 2>/dev/null || true)" \
    --arg check_exit "$(cat "$rd/$name.check-exit" 2>/dev/null || true)" \
    --argjson red_exit "$(cat "$rd/$name.red-exit" 2>/dev/null || echo null)" \
    --argjson scope "$(journal_lines "$rd/$name.scope")" \
    --argjson changed "$(journal_lines "$rd/$name.changed")" \
    --argjson outside "$(journal_lines "$rd/$name.outside")" \
    --argjson concurrent "$(journal_lines "$rd/$name.concurrent")" \
    --arg ctx "$(agent_ctx "$name")" \
    '{event: "ask", ts: $ts, project: $project, name: $name, role: $role, agent: $agent, model: $model, models: $models,
      fallback_errors: $fallback_errors,
      status: $status, autofix: $autofix, head: $head, base: $base, check: $check, check_exit: $check_exit, scope: $scope, changed: $changed, outside_scope: $outside, concurrent: $concurrent,
      ctx: $ctx, brief: $brief, payload: $payload, claims: $claims, red_exit: $red_exit}' >> "$JOURNAL"
}

cmd_note() {
  local name="${1:-}" text="${2:-}"
  [[ -n "$name" && -n "$text" ]] || usage
  local rd out cwd
  rd="$(run_dir)"
  out="$(cat "$rd/$name.out" 2>/dev/null || true)"
  cwd="$(agent_cwd "$name")"
  jq -nc --arg ts "$(date +%Y-%m-%dT%H:%M:%S%z)" --arg project "$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || echo "$cwd")" \
    --arg name "$name" --arg role "$(cat "$rd/$name.role" 2>/dev/null || echo unknown)" \
    --arg agent "$(agent_kind "$name")" --arg model "$(agent_model "$name")" \
    --arg brief "${out:+${out%.md}.brief}" --arg text "$text" \
    '{event: "note", ts: $ts, project: $project, name: $name, role: $role, agent: $agent, model: $model,
      brief: $brief, text: $text}' >> "$JOURNAL"
  echo "noted in $JOURNAL"
}

cmd_wait() {
  local name="${1:-}"; shift || usage
  local timeout=3000000
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) timeout="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  if [[ "$(agent_kind "$name")" == zcode ]]; then
    [[ -f "$(zcode_request_file "$name")" ]] || die "no pending request for $name"
    local res
    res="$(dispatch_wait "$name" "$timeout")" || true
    if [[ "$res" == timeout ]]; then
      echo "STATUS: still_working"
      exit 0
    fi
    finish "$name" "$timeout"
    return
  fi
  if ! dispatch_wait "$name" "$timeout"; then
    echo "STATUS: still_working"
    exit 0
  fi
  finish "$name" "$timeout"
}

cmd_diff() {
  local name="${1:-}"; [[ -n "$name" ]] || usage; shift
  local rd base cwd; rd="$(run_dir)"
  base="$(cat "$rd/$name.base" 2>/dev/null || true)"
  [[ -n "$base" ]] || die "no snapshot for $name (cwd is not a git tree)"
  cwd="$(agent_cwd "$name")"
  git -C "$cwd" diff "$@" "$base" "$(snapshot_tree "$cwd")"
}

cmd_peek() {
  local name="${1:-}"; [[ -n "$name" ]] || usage
  herdr agent read "$(agent_target "$name")" --source recent-unwrapped --lines "${2:-40}"
}

cmd_ls() {
  local rd; rd="$(run_dir)"
  local name
  for f in "$rd"/*.role; do
    [[ -e "$f" ]] || continue
    name="$(basename "$f" .role)"
    if agent_json "$name" >/dev/null 2>&1; then
      echo "$name $(cat "$f") $(agent_status "$name") $(agent_json "$name" | jq -r .result.agent.pane_id) ctx=$(agent_ctx "$name") model=$(agent_model "$name")"
    fi
  done
}

cmd_stop() {
  local name="${1:-}"; [[ -n "$name" ]] || usage
  local rd pane; rd="$(run_dir)"
  pane="$(agent_pane "$name")"
  if [[ "$(agent_kind "$name")" == zcode ]]; then
    [[ -n "$pane" ]] || die "no pane for $name"
    zcode_save_session "$name"
  fi
  agent_session "$name" > "$rd/$name.session"
  herdr pane close "$pane" >/dev/null
  rm -f "$rd/$name.mark"
  echo "stopped $name ($pane); bring back with: hd resume $name"
}

cmd_resume() {
  local name="${1:-}"; [[ -n "$name" ]] || usage
  shift
  if [[ "$(agent_kind "$name")" == zcode ]]; then
    resume_zcode "$name" "$@"
    return
  fi
  local rd session slot saved=() saved_fallback="" body
  rd="$(run_dir)"
  session="$(cat "$rd/$name.session" 2>/dev/null || true)"
  [[ -f "$session" && -f "$rd/$name.role" ]] || die "no stopped session for $name"
  slot="$(cat "$rd/$name.slot" 2>/dev/null || cat "$rd/$name.role")"
  body="$(config_json "$(config_path)")"
  slot_known "$body" "$slot" || slot="$(cat "$rd/$name.role")"
  [[ -f "$rd/$name.fallback" ]] && saved_fallback="$(<"$rd/$name.fallback")"
  [[ -f "$rd/$name.cwd" ]] && saved+=(--cwd "$(<"$rd/$name.cwd")")
  [[ -f "$rd/$name.model" ]] && saved+=(--model "$(<"$rd/$name.model")")
  [[ -f "$rd/$name.thinking" ]] && saved+=(--thinking "$(<"$rd/$name.thinking")")
  [[ -f "$rd/$name.agent" ]] && saved+=(--agent "$(<"$rd/$name.agent")")
  cmd_spawn "$name" "$slot" --session "$session" "${saved[@]}" "$@"
  [[ -z "$saved_fallback" ]] || printf '%s\n' "$saved_fallback" > "$rd/$name.fallback"
}

case "${1:-}" in
  spawn) shift; cmd_spawn "$@" ;;
  ask) shift; cmd_ask "$@" ;;
  wait) shift; cmd_wait "$@" ;;
  result) shift; print_result "${1:?}" ;;
  diff) shift; cmd_diff "$@" ;;
  peek) shift; cmd_peek "$@" ;;
  ls) cmd_ls ;;
  stop) shift; cmd_stop "$@" ;;
  resume) shift; cmd_resume "$@" ;;
  note) shift; cmd_note "$@" ;;
  *) usage ;;
esac
