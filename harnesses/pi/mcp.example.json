{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@3.2.5"
      ],
      "lifecycle": "lazy",
      "exposure": "deferred"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "lifecycle": "lazy",
      "exposure": "deferred"
    }
  }
}
